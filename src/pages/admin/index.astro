---
import { commentConfig } from "@/config/commentConfig";
import { siteConfig } from "@/config/siteConfig";
import { url } from "@/utils/url-utils";

const isLocal = import.meta.env.DEV;
const publishingConfigured =
	isLocal || Boolean(import.meta.env.PUBLIC_CMS_AUTH_BASE_URL?.trim());
const commentsConfigured = commentConfig.type !== "none";
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>创作中心 · {siteConfig.title}</title>
	</head>
	<body>
		<main>
			<header>
				<a class="back" href={url("/")}>← 返回博客</a>
				<span class="badge">{isLocal ? "本地工作区" : "在线管理"}</span>
			</header>
			<section class="intro">
				<p class="eyebrow">{siteConfig.title}</p>
				<h1>把故事写下来。</h1>
				<p>在这里写作、保存草稿、发布文章，与读者交流。</p>
				<a class="primary" href={url("/admin/editor/#/collections/posts/new")}>开始写文章 →</a>
			</section>
			<div class="cards">
				<section class="card">
					<span class="number">01 / WRITE</span>
					<h2>文章管理</h2>
					<p>可视化编辑 Markdown，上传图片，设置分类、标签、封面和评论开关。</p>
					<a href={url("/admin/editor/#/collections/posts")}>管理文章与草稿 →</a>
				</section>
				<section class="card">
					<span class="number">02 / CONNECT</span>
					<h2>评论与留言</h2>
					<p>文章下方支持评论和回复。在评论区点击管理图标，可设置管理员密码并审核留言。</p>
					<a href={url("/guestbook/#post-comments")}>打开留言与评论管理 →</a>
				</section>
			</div>
			<section class="setup" aria-labelledby="setup-title">
				<h2 id="setup-title">发布状态</h2>
				<p><strong>文章：</strong>{publishingConfigured ? (isLocal ? "保存到本地 Markdown 文件，不自动提交 Git。" : "使用 GitHub 登录，保存后提交至内容仓库。") : "在线编辑尚未配置。在部署平台设置 PUBLIC_CMS_AUTH_BASE_URL 后重新构建。"}</p>
				<p><strong>评论：</strong>{commentsConfigured ? "已配置评论服务；留言会保存在服务端。" : "尚未配置评论服务。本地运行 pnpm dev:blog；线上设置 PUBLIC_TWIKOO_ENV_ID 后重新构建。"}</p>
				<p>新文章默认是草稿。关闭“草稿”后保存，再构建部署，文章才会出现在正式站点。</p>
				{isLocal && <p class="command">完整本地环境：<code>pnpm dev:blog</code></p>}
			</section>
			<footer>内容属于你，文章保存在仓库，评论保存在自己的服务中。</footer>
		</main>
	</body>
</html>

<style>
	:global(*) { box-sizing: border-box; }
	:global(body) { margin: 0; color: #173346; background: #f1f7f9; font-family: system-ui, sans-serif; line-height: 1.7; }
	main { max-width: 1040px; margin: auto; padding: 32px 24px; }
	header { display: flex; justify-content: space-between; align-items: center; }
	a { color: #007d96; text-decoration: none; font-weight: 600; }
	a:hover { text-decoration: underline; }
	a:focus-visible { outline: 3px solid #00b6d3; outline-offset: 5px; }
	.badge { background: #d6eff2; padding: 4px 14px; border-radius: 20px; font-size: 13px; }
	.intro { padding: 60px 0 46px; }
	.eyebrow, .number { color: #007d96; letter-spacing: .1em; font-size: 13px; }
	h1 { font-size: clamp(32px, 6vw, 56px); letter-spacing: -.04em; margin: 8px 0; line-height: 1.3; }
	h2 { font-size: 21px; margin: 12px 0; }
	p { color: #506672; }
	.primary { display: inline-block; background: #007e97; color: white; padding: 12px 24px; margin-top: 14px; border-radius: 12px; }
	.cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
	.card { background: white; padding: 28px; border: 1px solid #e2edf0; border-radius: 20px; }
	.card p { min-height: 82px; }
	.setup { margin-top: 28px; padding: 24px 28px; border-radius: 18px; border: 1px solid #d4e5ea; }
	.setup p { margin: 10px 0; overflow-wrap: anywhere; }
	code { background: #dcebef; padding: 4px 8px; border-radius: 6px; }
	footer { font-size: 13px; color: #607b87; margin-top: 30px; }
	@media (max-width: 600px) { .cards { grid-template-columns: 1fr; } .card p { min-height: 0; } .intro { padding: 40px 0 30px; } main { padding: 24px 18px; } }
</style>
