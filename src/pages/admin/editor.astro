---
import cmsScriptUrl from "decap-cms/dist/decap-cms.js?url";
import { cmsConfig } from "@/config/cmsConfig";
import { url } from "@/utils/url-utils";

const enabled =
	import.meta.env.DEV ||
	Boolean(import.meta.env.PUBLIC_CMS_AUTH_BASE_URL?.trim());
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>文章编辑器</title>
	</head>
	<body>
		<div id="editor-status" role="status">
			<p>{enabled ? "正在加载文章编辑器…" : "在线编辑未配置：请设置 PUBLIC_CMS_AUTH_BASE_URL，并为内容仓库配置 GitHub OAuth。"}</p>
			<a href={url("/admin/")}>返回创作中心</a>
		</div>
		<noscript>文章编辑器需要启用 JavaScript。</noscript>
		<div id="nc-root"></div>
		{enabled && <script is:inline define:vars={{ config: cmsConfig, scriptUrl: cmsScriptUrl }}>
			window.CMS_MANUAL_INIT = true;
			const cmsScript = document.createElement("script");
			cmsScript.src = scriptUrl;
			cmsScript.onload = () => {
				window.CMS.init({ config });
				document.getElementById("editor-status").hidden = true;
			};
			cmsScript.onerror = () => {
				document.querySelector("#editor-status p").textContent = "编辑器加载失败，请检查网络后刷新页面。";
			};
			document.head.append(cmsScript);
		</script>}
	</body>
</html>

<style>
	#editor-status { max-width: 720px; margin: 64px auto; padding: 24px; font: 16px/1.7 system-ui, sans-serif; }
</style>
