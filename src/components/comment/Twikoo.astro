---
import twikooScriptUrl from "twikoo/dist/twikoo.nocss.js?url";
import "twikoo/dist/twikoo.css";
import { commentConfig } from "@/config/commentConfig";
import { url } from "@/utils/url-utils";

interface Props {
	path: string;
}

const twikooConfig = commentConfig.twikoo;
if (!twikooConfig?.envId) {
	throw new Error("Twikoo requires PUBLIC_TWIKOO_ENV_ID or an explicit envId.");
}

const config = {
	envId: twikooConfig.envId,
	region: twikooConfig.region,
	lang: twikooConfig.lang,
	path: Astro.props.path,
};
const scriptUrl = twikooConfig.jsUrl || twikooScriptUrl;
const cssUrl = twikooConfig.cssUrl;
---

<firefly-twikoo data-config={JSON.stringify(config)} data-script-url={scriptUrl}>
	<p data-comment-status role="status">滚动到此处后加载评论…</p>
	<button type="button" data-comment-retry hidden class="btn-regular rounded-lg px-4 py-2">重新加载评论</button>
	<div id="tcomment"></div>
</firefly-twikoo>
{cssUrl && <link rel="stylesheet" href={url(cssUrl)} />}

<script>
	import { registerTwikooComments } from "./twikoo-comments";
	registerTwikooComments();
</script>

<style>
	firefly-twikoo { display: block; min-height: 120px; }
	[data-comment-status] { color: var(--content-meta); margin: 12px 0; }
	[data-comment-retry][hidden] { display: none; }
</style>
